{
  "_comment": "Celery worker — scales 1-20 based on Redis queue depth (SQS-based autoscaling or custom CloudWatch metric).",
  "family": "cleardocs-worker",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "1024",
  "memory": "2048",
  "executionRoleArn": "arn:aws:iam::<AWS_ACCOUNT_ID>:role/cleardocs-ecs-execution-role",
  "taskRoleArn": "arn:aws:iam::<AWS_ACCOUNT_ID>:role/cleardocs-worker-task-role",
  "containerDefinitions": [
    {
      "name": "worker",
      "image": "<AWS_ACCOUNT_ID>.dkr.ecr.us-east-1.amazonaws.com/cleardocs-backend:latest",
      "essential": true,
      "command": [
        "celery", "-A", "config", "worker",
        "--loglevel=info",
        "--concurrency=2",
        "-Q", "default,ocr,llm"
      ],
      "environment": [
        { "name": "DJANGO_SETTINGS_MODULE", "value": "config.settings.production" },
        { "name": "POSTGRES_HOST",          "value": "<RDS_ENDPOINT>" },
        { "name": "POSTGRES_DB",            "value": "cleardocs" },
        { "name": "POSTGRES_PORT",          "value": "5432" },
        { "name": "AWS_S3_REGION",          "value": "us-east-1" },
        { "name": "LLM_PROVIDER",           "value": "openai" }
      ],
      "secrets": [
        { "name": "SECRET_KEY",            "valueFrom": "arn:aws:secretsmanager:us-east-1:<AWS_ACCOUNT_ID>:secret:cleardocs/prod/secret-key" },
        { "name": "POSTGRES_USER",         "valueFrom": "arn:aws:secretsmanager:us-east-1:<AWS_ACCOUNT_ID>:secret:cleardocs/prod/db-username" },
        { "name": "POSTGRES_PASSWORD",     "valueFrom": "arn:aws:secretsmanager:us-east-1:<AWS_ACCOUNT_ID>:secret:cleardocs/prod/db-password" },
        { "name": "REDIS_URL",             "valueFrom": "arn:aws:secretsmanager:us-east-1:<AWS_ACCOUNT_ID>:secret:cleardocs/prod/redis-url" },
        { "name": "OPENAI_API_KEY",        "valueFrom": "arn:aws:secretsmanager:us-east-1:<AWS_ACCOUNT_ID>:secret:cleardocs/prod/openai-api-key" },
        { "name": "GROQ_API_KEY",          "valueFrom": "arn:aws:secretsmanager:us-east-1:<AWS_ACCOUNT_ID>:secret:cleardocs/prod/groq-api-key" },
        { "name": "AWS_ACCESS_KEY_ID",     "valueFrom": "arn:aws:secretsmanager:us-east-1:<AWS_ACCOUNT_ID>:secret:cleardocs/prod/aws-access-key-id" },
        { "name": "AWS_SECRET_ACCESS_KEY", "valueFrom": "arn:aws:secretsmanager:us-east-1:<AWS_ACCOUNT_ID>:secret:cleardocs/prod/aws-secret-access-key" },
        { "name": "AWS_S3_BUCKET",         "valueFrom": "arn:aws:secretsmanager:us-east-1:<AWS_ACCOUNT_ID>:secret:cleardocs/prod/s3-bucket" },
        { "name": "SENTRY_DSN",            "valueFrom": "arn:aws:secretsmanager:us-east-1:<AWS_ACCOUNT_ID>:secret:cleardocs/prod/sentry-dsn" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group":         "/ecs/cleardocs-worker",
          "awslogs-region":        "us-east-1",
          "awslogs-stream-prefix": "ecs",
          "awslogs-create-group":  "true"
        }
      },
      "ulimits": [
        { "name": "nofile", "softLimit": 65536, "hardLimit": 65536 }
      ]
    }
  ]
}
