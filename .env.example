# ─── Django ────────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string-in-production
DJANGO_SETTINGS_MODULE=config.settings.development

# ─── PostgreSQL ─────────────────────────────────────────────────────────────────
POSTGRES_DB=cleardocs
POSTGRES_USER=cleardocs
POSTGRES_PASSWORD=change-me

# ─── LLM Provider ───────────────────────────────────────────────────────────────
# Options: groq (free), openai, anthropic
LLM_PROVIDER=groq

# Groq — free tier, get key at https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# OpenAI — paid, get key at https://platform.openai.com
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic — paid, get key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# ─── AWS S3 (leave blank to use local filesystem storage in dev) ────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=cleardocs-local
AWS_S3_REGION=us-east-1
# For LocalStack (local AWS simulation): http://localhost:4566
AWS_S3_ENDPOINT_URL=

# ─── Email (optional in dev — emails print to console by default) ────────────────
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
DEFAULT_FROM_EMAIL=noreply@cleardocs.app

# ─── Sentry (optional — leave blank to disable) ─────────────────────────────────
SENTRY_DSN=

# ─── Frontend (Next.js) ─────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost
